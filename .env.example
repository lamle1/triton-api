# Copy to Docker/.env for local deployment.
# Do not commit Docker/.env because it can contain environment secrets.

# ── API Authorization & Admin Credentials ─────────────────────────────────────
# Admin password for initial web portal authentication (/admin/)
ADMIN_PASSWORD=admin123

# Require X-API-Key header for inference endpoints (true/false)
REQUIRE_API_KEY=true

# ── go2rtc access ─────────────────────────────────────────────────────────────
# go2rtc is accessed through the API server's built-in reverse proxy at /go2rtc/
# Set GO2RTC_PUBLIC_URL to the public URL or IP of the API server.
# Examples:
#   Localhost:   GO2RTC_PUBLIC_URL=http://localhost:8003
#   LAN IP:      GO2RTC_PUBLIC_URL=http://192.168.1.10:8003
#   Domain:      GO2RTC_PUBLIC_URL=https://triton-api.yourdomain.com
GO2RTC_PUBLIC_URL=http://localhost:8003

# Re-ID Retention Policy (Days)
REID_RETENTION_DAYS=7

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins for the API server.
# "*" allows any origin — fine for local/LAN deployments, set exact domain for production.
CORS_ORIGINS=*

# ── Performance Notes ──────────────────────────────────────────────────────────
# SWAP: Ensure system memory is adequate to prevent swap paging on cold-start text encoding.
# GPU targeting: Set target GPU index in model config.pbtxt:
#   instance_group [{ kind: KIND_GPU  gpus: [0] }]
