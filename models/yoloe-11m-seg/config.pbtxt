name: "yoloe-11m-seg"
max_batch_size: 0

input {
  name:      "images"
  data_type: TYPE_FP32
  dims: [-1, 3, -1, -1]
}
input {
  name:      "prompt_embedding"
  data_type: TYPE_FP32
  dims: [-1, -1, 512]
}
output {
  name:      "output0"
  data_type: TYPE_FP32
  dims: [-1, -1, -1]
}
output {
  name:      "output1"
  data_type: TYPE_FP32
  dims: [-1, 32, -1, -1]
}

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

